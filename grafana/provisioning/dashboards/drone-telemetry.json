            { "id": "custom.width", "value": 100 }
          ]},
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
            { "id": "mappings", "value": [{ "type": "value", "options": { "HEALTHY": { "color": "green", "index": 0 }, "WARNING": { "color": "yellow", "index": 1 }, "CRITICAL": { "color": "red", "index": 2 } } }] },
            { "id": "custom.width", "value": 90 }
          ]},
          { "matcher": { "id": "byName", "options": "Mode" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
            { "id": "mappings", "value": [{ "type": "value", "options": { "MISSION": { "color": "green", "index": 0 }, "RTL": { "color": "yellow", "index": 1 }, "EMERGENCY": { "color": "red", "index": 2 } } }] },
            { "id": "custom.width", "value": 100 }
          ]},
          { "matcher": { "id": "byName", "options": "Signal %" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 70 }] } },
            { "id": "custom.width", "value": 90 }
          ]},
          { "matcher": { "id": "byName", "options": "GPS Sats" }, "properties": [
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 4 }, { "color": "green", "value": 6 }] } },
            { "id": "custom.width", "value": 80 }
          ]},
          { "matcher": { "id": "byName", "options": "Motor" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "OK": { "color": "green", "index": 0 } } },
              { "type": "regex", "options": { "pattern": "^Motor.*", "result": { "color": "red", "index": 1 } } }
