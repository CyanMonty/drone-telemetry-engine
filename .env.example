# Postgres / TimescaleDB
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry

# Kafka
KAFKA_TOPIC=drone-telemetry
KAFKA_GROUP_ID=telemetry-consumer

# Simulator
# RUN_MODE: 'scale' (default) or 'dev'
RUN_MODE=scale

# scale mode: pure-Python coroutines, supports up to ~1000
NUM_DRONES=100
TELEMETRY_RATE_HZ=2

# dev mode: real PX4 SITL via MAVSDK — all drones in one shared Gazebo world
# Uncomment and set RUN_MODE=dev to use.
# PX4_NUM_DRONES sets how many instances spawn inside the px4-swarm container (1–5).
# PX4_ADDRESSES must have one entry per drone: port = 14540 + instance index.
# PX4_NUM_DRONES=3
# PX4_VEHICLE=gz_x500
# PX4_WORLD=default
# PX4_DRONE_SPACING=2
# PX4_ADDRESSES=udp://px4-swarm:14540,udp://px4-swarm:14541,udp://px4-swarm:14542

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
